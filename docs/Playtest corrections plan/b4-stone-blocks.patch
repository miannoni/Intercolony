+        /// <summary>
+        /// B4 regression: force one real vanilla block def through every sale gate. The
+        /// temporary stack and stockpile are removed even when an assertion throws.
+        /// </summary>
+        private static void RunStoneBlockChecks(
+            IntercolonyWorldComponent state,
+            Map map,
+            StringBuilder sb,
+            Action<string, bool, string> check)
+        {
+            sb.AppendLine("  Stone block tradability:");
+            ThingDef blocks = DefDatabase<ThingDef>.GetNamedSilentFail("BlocksGranite");
+            check("vanilla BlocksGranite def exists", blocks != null, null);
+            if (blocks == null)
+            {
+                return;
+            }
+
+            check("BlocksGranite player sale tradeability passes",
+                blocks.tradeability.PlayerCanSell(), blocks.tradeability.ToString());
+            check("BlocksGranite clears the classifier market-value floor",
+                blocks.BaseMarketValue >= 0.4f, blocks.BaseMarketValue.ToString("F2"));
+            check("BlocksGranite is not blacklisted",
+                !IntercolonyTradeBlacklist.IsBlacklisted(blocks), null);
+            check("BlocksGranite category ancestry reaches StoneBlocks",
+                HasCategory(blocks, ThingCategoryDefOf.StoneBlocks), null);
+            check("BlocksGranite classifies as intermediate goods",
+                IntercolonyProductClassifier.Classify(blocks) ==
+                IntercolonyProductCategory.IntermediateGoods,
+                IntercolonyProductClassifier.Classify(blocks)?.ToString() ?? "unclassified");
+            check("BlocksGranite is fungible",
+                IntercolonyProductClassifier.IsFungibleTradeItem(blocks), null);
+            check("BlocksGranite appears in TradableDefs",
+                IntercolonyProductClassifier.TradableDefs.Contains(blocks), null);
+            check("BlocksGranite is a generated-demand candidate",
+                IntercolonyProductClassifier.DefsInCategory(
+                    IntercolonyProductCategory.IntermediateGoods).Contains(blocks), null);
+
+            List<BuyerOffer> offers = FindBuyerService.FindBuyers(state, blocks, null, 10);
+            Settlement accessibleBuyer = FirstAccessibleSettlement();
+            if (accessibleBuyer == null)
+            {
+                sb.AppendLine("    buyer evaluation skipped: no accessible settlement in this world");
+            }
+            else
+            {
+                bool normalEvaluation = offers.Count > 0;
+                foreach (BuyerOffer offer in offers)
+                {
+                    normalEvaluation &= offer.def == blocks &&
+                        (offer.Interested
+                            ? offer.quantity > 0 && offer.maxQuantity > 0 && offer.unitPrice > 0f
+                            : !string.IsNullOrEmpty(offer.noInterestReason));
+                }
+
+                check("BlocksGranite produces normal buyer evaluation", normalEvaluation,
+                    $"{offers.Count} settlement row(s)");
+            }
+
+            string explanation = IntercolonyDebugActions.ExplainTradability(blocks);
+            check("BlocksGranite tradability diagnostic reaches a tradable result",
+                explanation.Contains("- result: tradable") &&
+                explanation.Contains("- category: StoneBlocks") &&
+                explanation.Contains("-> IntermediateGoods"),
+                explanation.Replace('\n', ' '));
+
+            if (map == null)
+            {
+                check("stone block stock test has a current map", false,
+                    "run while viewing a colony map");
+                return;
+            }
+
+            Zone_Stockpile testZone = null;
+            Thing testStock = null;
+            try
+            {
+                IntVec3 storageCell = IntVec3.Invalid;
+                IntVec3 root = DropCellFinder.TradeDropSpot(map);
+                foreach (IntVec3 candidate in GenRadial.RadialCellsAround(root, 12f, useCenter: true))
+                {
+                    if (candidate.InBounds(map) && candidate.Standable(map) &&
+                        candidate.GetFirstItem(map) == null && map.zoneManager.ZoneAt(candidate) == null)
+                    {
+                        storageCell = candidate;
+                        break;
+                    }
+                }
+
+                if (!storageCell.IsValid)
+                {
+                    check("stone block stock test found a temporary storage cell", false,
+                        "no empty unzoned cell near the trade drop spot");
+                    return;
+                }
+
+                int physicalBefore = ListedQuantity(FindBuyerService.ColonyStock(map), blocks);
+                testZone = new Zone_Stockpile(StorageSettingsPreset.DefaultStockpile, map.zoneManager);
+                map.zoneManager.RegisterZone(testZone);
+                testZone.AddCell(storageCell);
+
+                Thing stack = ThingMaker.MakeThing(blocks);
+                stack.stackCount = 10;
+                testStock = GenSpawn.Spawn(stack, storageCell, map);
+
+                int physicalAfter = ListedQuantity(FindBuyerService.ColonyStock(map), blocks);
+                int availableWithoutCommitments = ListedQuantity(
+                    FindBuyerService.AvailableColonyStock(null, map), blocks);
+                check("stored BlocksGranite stack appears in ColonyStock",
+                    physicalAfter == physicalBefore + 10,
+                    $"before {physicalBefore}, after {physicalAfter}");
+                check("stored BlocksGranite survives the availability layer",
+                    availableWithoutCommitments == physicalAfter,
+                    $"physical {physicalAfter}, available {availableWithoutCommitments}");
+
+                int committed = FindBuyerService.CommittedQuantity(state, blocks);
+                int expectedAvailable = Mathf.Max(0, physicalAfter - committed);
+                int actualAvailable = ListedQuantity(
+                    FindBuyerService.AvailableColonyStock(state, map), blocks);
+                check("BlocksGranite availability subtracts only commitments",
+                    actualAvailable == expectedAvailable,
+                    $"physical {physicalAfter}, committed {committed}, available {actualAvailable}");
+            }
+            finally
+            {
+                if (testStock != null && !testStock.Destroyed)
+                {
+                    testStock.Destroy(DestroyMode.Vanish);
+                }
+
+                testZone?.Delete(playSound: false);
+            }
+        }
